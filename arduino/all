void connectWiFi() {
    Serial.println();
    Serial.println("=========================================");
    Serial.print("🌐 Menghubungkan ke WiFi: ");
    Serial.println(WIFI_SSID);

    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

    int attempt = 0;
    while (WiFi.status() != WL_CONNECTED && attempt < 20) {
        delay(500);
        Serial.print(".");
        attempt++;
    }

    if (WiFi.status() == WL_CONNECTED) {
        Serial.println();
        Serial.println("✅ WiFi terhubung!");
        Serial.print("   IP Address : ");
        Serial.println(WiFi.localIP());
    } else {
        Serial.println();
        Serial.println("❌ WiFi GAGAL terhubung! Mode offline.");
    }
    Serial.println("=========================================");
}

//==================================================
// FUNGSI KIRIM DATA KE SERVER
//==================================================

void kirimDataKeServer(String warna, float r, float g, float b, float berat) {

    if (WiFi.status() != WL_CONNECTED) {
        Serial.println("⚠️ WiFi tidak terhubung, skip kirim data.");
        return;
    }

    int r_int = (int)(r * 100);
    int g_int = (int)(g * 100);
    int b_int = (int)(b * 100);

    HTTPClient http;
    http.begin(SERVER_URL);
    http.addHeader("Content-Type", "application/x-www-form-urlencoded");

    String postData = "warna=" + warna +
                      "&r="    + String(r_int) +
                      "&g="    + String(g_int) +
                      "&b="    + String(b_int) +
                      "&berat="+ String(berat, 2);

    Serial.println();
    Serial.println("📡 KIRIM DATA KE SERVER:");
    Serial.println("   " + postData);

    int httpCode = http.POST(postData);

    if (httpCode > 0) {
        String response = http.getString();
        Serial.print("   HTTP Code : "); Serial.println(httpCode);
        Serial.print("   Response  : "); Serial.println(response);
        if (httpCode == 200) {
            Serial.println("✅ Data berhasil dikirim ke server!");
        } else {
            Serial.println("⚠️ Server merespon tapi ada masalah.");
        }
    } else {
        Serial.print("❌ HTTP Error: ");
        Serial.println(http.errorToString(httpCode));
    }

    http.end();
}

//==================================================
// FUNGSI BACA WARNA
//==================================================

long readColor(bool s2, bool s3) {
    digitalWrite(S2, s2);
    digitalWrite(S3, s3);
    delay(5);

    long total = 0;
    for (int i = 0; i < 10; i++) {
        total += pulseIn(SENSOR_OUT, LOW, 100000);
    }
    return total / 10;
}

void readAllColors() {
    digitalWrite(S0, HIGH);
    digitalWrite(S1, LOW);
    
    redValue = readColor(LOW, LOW);
    blueValue = readColor(LOW, HIGH);
    greenValue = readColor(HIGH, HIGH);
    
    digitalWrite(S0, LOW);
    digitalWrite(S1, HIGH);
}

//==================================================
// FUNGSI EUCLIDEAN DISTANCE
//==================================================

float distanceRGB(float r1, float g1, float b1,
                  float r2, float g2, float b2) {
    return sqrt(
        pow(r1 - r2, 2) +
        pow(g1 - g2, 2) +
        pow(b1 - b2, 2));
}

//==================================================
// FUNGSI KLASIFIKASI
//==================================================

int klasifikasiBiji(float r, float g, float b) {
    float dN1 = distanceRGB(r, g, b, N1_R, N1_G, N1_B);
    float dN2 = distanceRGB(r, g, b, N2_R, N2_G, N2_B);
    float dMR = distanceRGB(r, g, b, MR_R, MR_G, MR_B);
    float dHJ = distanceRGB(r, g, b, HJ_R, HJ_G, HJ_B);
    
    float minDist = dN1;
    int kategori = 0;
    
    if (dN2 < minDist) {
        minDist = dN2;
        kategori = 0;
    }
    
    if (dMR < minDist) {
        minDist = dMR;
        kategori = 1;
    }
    
    if (dHJ < minDist) {
        minDist = dHJ;
        kategori = 2;
    }
    
    return kategori;
}

bool adaBiji() {
    readAllColors();
    
    float total = redValue + greenValue + blueValue;
    if (total == 0) return false;
    
    float r = (redValue * 100.0) / total;
    float g = (greenValue * 100.0) / total;
    float b = (blueValue * 100.0) / total;
    
    float dN1 = distanceRGB(r, g, b, N1_R, N1_G, N1_B);
    float dN2 = distanceRGB(r, g, b, N2_R, N2_G, N2_B);
    float dMR = distanceRGB(r, g, b, MR_R, MR_G, MR_B);
    float dHJ = distanceRGB(r, g, b, HJ_R, HJ_G, HJ_B);
    
    float minDist = dN1;
    
    if (dN2 < minDist) minDist = dN2;
    if (dMR < minDist) minDist = dMR;
    if (dHJ < minDist) minDist = dHJ;
    
    if (dMR == minDist || dHJ == minDist) {
        return true;
    }
    
    return false;
}

//==================================================
// FUNGSI LOAD CELL
//==================================================

void initLoadCells() {
    Serial.println();
    Serial.println("=========================================");
    Serial.println("📦 INISIALISASI LOAD CELL");
    Serial.println("=========================================");

    scale1.begin(LOADCELL1_DT, LOADCELL1_SCK);
    scale2.begin(LOADCELL2_DT, LOADCELL2_SCK);

    int timeout1 = 0;
    while (!scale1.is_ready() && timeout1 < 20) {
        Serial.println("HX711 1 belum terdeteksi...");
        delay(500);
        timeout1++;
    }

    int timeout2 = 0;
    while (!scale2.is_ready() && timeout2 < 20) {
        Serial.println("HX711 2 belum terdeteksi...");
        delay(500);
        timeout2++;
    }

    if (scale1.is_ready()) {
        Serial.println("✅ Load Cell 1 terdeteksi");
    } else {
        Serial.println("❌ Load Cell 1 TIDAK terdeteksi!");
    }

    if (scale2.is_ready()) {
        Serial.println("✅ Load Cell 2 terdeteksi");
    } else {
        Serial.println("❌ Load Cell 2 TIDAK terdeteksi!");
    }

    // Warm-up: buang 50 pembacaan pertama (tidak stabil)
    Serial.println();
    Serial.println("⏳ Warm-up load cell (tunggu ~5 detik)...");
    for (int i = 0; i < 50; i++) {
        if (scale1.is_ready()) scale1.read();
        if (scale2.is_ready()) scale2.read();
        delay(100);
    }

    // TARE dengan 100 sample (lebih akurat)
    Serial.println("⚖️ Melakukan TARE (100 sample)...");
    delay(500);

    if (scale1.is_ready()) {
        offset1 = scale1.read_average(100);
        Serial.print("  Offset LC1 : ");
        Serial.println(offset1);
    }

    if (scale2.is_ready()) {
        offset2 = scale2.read_average(100);
        Serial.print("  Offset LC2 : ");
        Serial.println(offset2);
    }

    // Init rolling average buffer dengan 0
    for (int i = 0; i < ROLLING_SIZE; i++) {
        history1[i] = 0;
        history2[i] = 0;
    }

    Serial.println("✅ TARE selesai");
    Serial.print("  Noise threshold : "); Serial.print(NOISE_THRESHOLD); Serial.println(" gram");
    Serial.print("  Rolling avg size: "); Serial.println(ROLLING_SIZE);
    Serial.println("=========================================");
}

float bacaBerat1() {
    if (!scale1.is_ready()) return 0;

    float sum = 0;
    for (int i = 0; i < 5; i++) {
        long raw = scale1.read_average(10);
        // pakai abs() agar tidak peduli arah pasang fisik LC
        float berat = abs((float)(raw - offset1)) / calibration_factor1;
        sum += berat;
        delay(20);
    }
    float avg = sum / 5.0;

    return (avg < NOISE_THRESHOLD) ? 0.0 : avg;
}

float bacaBerat2() {
    if (!scale2.is_ready()) return 0;

    float sum = 0;
    for (int i = 0; i < 5; i++) {
        long raw = scale2.read_average(10);
        // pakai abs() agar tidak peduli arah pasang fisik LC
        float berat = abs((float)(raw - offset2)) / calibration_factor2;
        sum += berat;
        delay(20);
    }
    float avg = sum / 5.0;

    return (avg < NOISE_THRESHOLD) ? 0.0 : avg;
}

void tampilkanBerat() {
    float berat1 = bacaBerat1();
    float berat2 = bacaBerat2();
    
    Serial.println("📦 DATA LOAD CELL:");
    Serial.print("  LC1 : ");
    Serial.print(berat1, 2);
    Serial.println(" gram");
    Serial.print("  LC2 : ");
    Serial.print(berat2, 2);
    Serial.println(" gram");
}

//==================================================
// FUNGSI SERVO - DIPERBAIKI
//==================================================

void moveServo(int pin, int fromPos, int toPos, String name) {
    // Pilih servo berdasarkan pin
    Servo* servoPtr;
    if (pin == SERVO1_PIN) {
        servoPtr = &servo1;
    } else {
        servoPtr = &servo2;
    }
    
    Serial.print("  ");
    Serial.print(name);
    Serial.print(": ");
    Serial.print(fromPos);
    Serial.print("° → ");
    Serial.println(toPos);
    
    int stepDelay = 10;
    int stepSize = 2;
    
    if (fromPos < toPos) {
        for (int i = fromPos; i <= toPos; i += stepSize) {
            servoPtr->write(i);
            delay(stepDelay);
        }
    } else {
        for (int i = fromPos; i >= toPos; i -= stepSize) {
            servoPtr->write(i);
            delay(stepDelay);
        }
    }
    servoPtr->write(toPos);
    delay(50);
}

//==================================================
// FUNGSI SORTIR UTAMA
//==================================================

void prosesSortir() {
    if (isProcessing) return;
    isProcessing = true;
    
    readAllColors();
    
    float total = redValue + greenValue + blueValue;
    if (total == 0) {
        Serial.println("⚠️ Error: Total = 0");
        isProcessing = false;
        return;
    }
    
    float r = (redValue * 100.0) / total;
    float g = (greenValue * 100.0) / total;
    float b = (blueValue * 100.0) / total;
    
    float dN1 = distanceRGB(r, g, b, N1_R, N1_G, N1_B);
    float dN2 = distanceRGB(r, g, b, N2_R, N2_G, N2_B);
    float dMR = distanceRGB(r, g, b, MR_R, MR_G, MR_B);
    float dHJ = distanceRGB(r, g, b, HJ_R, HJ_G, HJ_B);
    
    int kategori = klasifikasiBiji(r, g, b);
    
    if (kategori == 0) {
        isProcessing = false;
        return;
    }
    
    int posisiServo2;
    
    if (kategori == 1) {
        posisiServo2 = S2_MERAH;
        total_merah++;
        Serial.println("🔴 MERAH → Servo ke 45° (LC2)");
    } else {
        posisiServo2 = S2_HIJAU;
        total_hijau++;
        Serial.println("🟢 HIJAU → Servo ke 135° (LC1)");
    }
    
    total_sortir++;
    
    moveServo(SERVO2_PIN, S2_STANDBY, posisiServo2, "Servo2");
    delay(300);
    
    moveServo(SERVO1_PIN, S1_STANDBY, S1_BACA, "Servo1");
    delay(300);
    
    moveServo(SERVO1_PIN, S1_BACA, S1_STANDBY, "Servo1");
    delay(300);
    
    moveServo(SERVO2_PIN, posisiServo2, S2_STANDBY, "Servo2");
    delay(300);

    // Tunggu biji settle di load cell sebelum baca berat
    delay(1000);

    // Baca berat SETELAH biji masuk load cell
    float berat1 = bacaBerat1();
    float berat2 = bacaBerat2();
    total_berat += (berat1 + berat2);

    // Mapping fisik:
    // Servo 45°  (MERAH) → biji jatuh ke LC2
    // Servo 135° (HIJAU) → biji jatuh ke LC1
    float berat = (kategori == 1) ? berat2 : berat1;

    Serial.print("⚖️ Berat: "); Serial.print(berat, 2);
    Serial.println(kategori == 1 ? " gram (LC2/Merah)" : " gram (LC1/Hijau)");

    // Kirim data ke server
    String warnaKirim = (kategori == 1) ? "MERAH" : "HIJAU";
    float r_pct = (redValue * 100.0) / (redValue + greenValue + blueValue);
    float g_pct = (greenValue * 100.0) / (redValue + greenValue + blueValue);
    float b_pct = (blueValue * 100.0) / (redValue + greenValue + blueValue);
    kirimDataKeServer(warnaKirim, r_pct, g_pct, b_pct, berat);

    int timeout = 0;
    while (adaBiji() && timeout < 50) {
        delay(100);
        timeout++;
    }

    Serial.println("✅ Selesai!");
    isProcessing = false;
}

