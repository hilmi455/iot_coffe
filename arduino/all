void setup() {
    delay(1000);
    
    ESP32PWM::allocateTimer(0);
    ESP32PWM::allocateTimer(1);
    ESP32PWM::allocateTimer(2);
    ESP32PWM::allocateTimer(3);
    
    Serial.begin(115200);
    
    while (!Serial) {
        delay(10);
    }
    
    Serial.println();
    Serial.println("=========================================");
    Serial.println("   COFFEE SORTING - MERAH vs HIJAU");
    Serial.println("=========================================");
    
    initLoadCells();
    
    Serial.println();
    Serial.println("Metode: EUCLIDEAN DISTANCE");
    Serial.println();
    Serial.println("REFERENSI KALIBRASI WARNA:");
    Serial.print("  NORMAL 1 : R="); Serial.print(N1_R);
    Serial.print(" G="); Serial.print(N1_G);
    Serial.print(" B="); Serial.println(N1_B);
    Serial.print("  NORMAL 2 : R="); Serial.print(N2_R);
    Serial.print(" G="); Serial.print(N2_G);
    Serial.print(" B="); Serial.println(N2_B);
    Serial.print("  MERAH    : R="); Serial.print(MR_R);
    Serial.print(" G="); Serial.print(MR_G);
    Serial.print(" B="); Serial.println(MR_B);
    Serial.print("  HIJAU    : R="); Serial.print(HJ_R);
    Serial.print(" G="); Serial.print(HJ_G);
    Serial.print(" B="); Serial.println(HJ_B);
    Serial.println("=========================================");
    Serial.println();

    pinMode(S0, OUTPUT);
    pinMode(S1, OUTPUT);
    pinMode(S2, OUTPUT);
    pinMode(S3, OUTPUT);
    pinMode(SENSOR_OUT, INPUT);

    digitalWrite(S0, HIGH);
    digitalWrite(S1, LOW);

    // Attach servo dengan benar
    servo1.attach(SERVO1_PIN, 500, 2500);
    servo2.attach(SERVO2_PIN, 500, 2500);

    servo1.write(S1_STANDBY);
    servo2.write(S2_STANDBY);
    
    Serial.println("✅ System Ready!");
    connectWiFi();
    tampilkanMenu();
}

//==================================================
// LOOP
//==================================================

void loop() {
    if (Serial.available() > 0) {
        char command = Serial.read();
        
        while (Serial.available() > 0) {
            Serial.read();
        }
        
        switch (command) {
            case '1':
                Serial.println();
                Serial.println("▶ START SORTIR (1x)");
                prosesSortir();
                tampilkanMenu();
                break;
                
            case '2':
                if (!autoMode) {
                    Serial.println();
                    Serial.println("▶ AUTO MODE START");
                    Serial.println("⚠️ Tekan '3' untuk STOP");
                    autoMode = true;
                } else {
                    Serial.println();
                    Serial.println("⚠️ Auto Mode sudah berjalan!");
                    tampilkanMenu();
                }
                break;
                
            case '3':
                if (autoMode) {
                    Serial.println();
                    Serial.println("⏹ AUTO MODE STOP");
                    autoMode = false;
                    tampilkanMenu();
                } else {
                    Serial.println();
                    Serial.println("⚠️ Auto Mode tidak aktif!");
                    tampilkanMenu();
                }
                break;
                
            case '4':
                Serial.println();
                Serial.println("🔄 RESET COUNTER");
                total_merah = 0;
                total_hijau = 0;
                total_sortir = 0;
                total_berat = 0.0;
                Serial.println("✅ Counter berhasil di-reset!");
                tampilkanMenu();
                break;
                
            default:
                Serial.println();
                Serial.println("❌ Perintah tidak dikenal! Gunakan 1-4");
                tampilkanMenu();
                break;
        }
    }
    
    if (autoMode && !isProcessing) {
        if (adaBiji()) {
            prosesSortir();
            tampilkanMenu();
        } else {
            static unsigned long lastDot = 0;
            if (millis() - lastDot > 1000) {
                Serial.print(".");
                lastDot = millis();
            }
        }
        delay(100);
    }
}