void kalibrasiSingleLC(int lc) {
    Serial.println();
    Serial.print("📌 Kalibrasi Load Cell ");
    Serial.println(lc);
    Serial.println("1. Pastikan tidak ada beban");
    Serial.println("2. Tekan 'y' untuk zero");
    Serial.println();
    Serial.print("Tekan 'y': ");
    
    while (!Serial.available()) delay(100);
    char input = Serial.read();
    while (Serial.available()) Serial.read();
    
    if (input == 'y' || input == 'Y') {
        HX711 &scale = (lc == 1) ? scale1 : scale2;
        long offset = scale.read_average(30);
        
        if (lc == 1) {
            offset1 = offset;
        } else {
            offset2 = offset;
        }
        
        Serial.println();
        Serial.print("✅ Zero selesai! Offset LC");
        Serial.print(lc);
        Serial.print(" = ");
        Serial.println(offset);
        Serial.println();
        
        Serial.print("2. Letakkan beban 100 gram, tekan 'y': ");
        while (!Serial.available()) delay(100);
        input = Serial.read();
        while (Serial.available()) Serial.read();
        
        if (input == 'y' || input == 'Y') {
            long raw = scale.read_average(10);
            float faktor = (offset - raw) / 100.0;
            
            if (lc == 1) {
                calibration_factor1 = faktor;
            } else {
                calibration_factor2 = faktor;
            }
            
            Serial.println();
            Serial.print("✅ Kalibrasi selesai! Faktor LC");
            Serial.print(lc);
            Serial.print(" = ");
            Serial.println(faktor, 2);
            Serial.println();
            Serial.println("⚠️ Update konstanta di program!");
        }
    }
}

void tareLoadCells() {
    Serial.println();
    Serial.println("⚖️ TARE LOAD CELL 1 & 2");
    Serial.println("Pastikan tidak ada beban!");
    Serial.print("Tekan 'y' untuk TARE: ");
    
    while (!Serial.available()) delay(100);
    char input = Serial.read();
    while (Serial.available()) Serial.read();
    
    if (input == 'y' || input == 'Y') {
        if (scale1.is_ready()) {
            offset1 = scale1.read_average(30);
            Serial.print("  Offset LC1 : ");
            Serial.println(offset1);
        }
        
        if (scale2.is_ready()) {
            offset2 = scale2.read_average(30);
            Serial.print("  Offset LC2 : ");
            Serial.println(offset2);
        }
        
        Serial.println("✅ TARE selesai!");
    } else {
        Serial.println("❌ Batal");
    }
}

