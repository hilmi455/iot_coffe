//==================================================
// FUNGSI ROLLING AVERAGE LOAD CELL
//==================================================

float rollingAverage(float* arr, float newVal) {
    arr[historyIndex] = newVal;
    int count = historyFull ? ROLLING_SIZE : (historyIndex + 1);
    float sum = 0;
    for (int i = 0; i < count; i++) sum += arr[i];
    return sum / count;
}

