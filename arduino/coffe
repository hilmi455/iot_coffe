// Fungsi readColor dengan parameter s2 dan s3
int readColor(bool s2, bool s3)
{
  digitalWrite(S2, s2);
  digitalWrite(S3, s3);

  delay(5);

  long total = 0;

  for (int i = 0; i < 10; i++)
  {
    total += pulseIn(SENSOR_OUT, LOW, 100000);
  }

  return total / 10;
}

// Fungsi untuk membaca semua warna sekaligus
void readAllColors() {
    // Set frekuensi output 20% (seperti di program kalibrasi)
    digitalWrite(S0, HIGH);
    digitalWrite(S1, LOW);
    
    // Baca RED (S2=LOW, S3=LOW)
    redValue = readColor(LOW, LOW);
    
    // Baca BLUE (S2=LOW, S3=HIGH)
    blueValue = readColor(LOW, HIGH);
    
    // Baca GREEN (S2=HIGH, S3=HIGH)
    greenValue = readColor(HIGH, HIGH);
    
    // Kembalikan ke setting awal untuk pembacaan selanjutnya
    digitalWrite(S0, LOW);
    digitalWrite(S1, HIGH);
}

//==================================================
// FUNGSI SERVO
//==================================================

void moveServoWithDebug(Servo &servo, int fromPos, int toPos, String name) {
    Serial.print("🔧 ");
    Serial.print(name);
    Serial.print(" bergerak dari ");
    Serial.print(fromPos);
    Serial.print(" ke ");
    Serial.println(toPos);
    
    int stepDelay = 15;
    
    if (fromPos < toPos) {
        for (int i = fromPos; i <= toPos; i++) {
            servo.write(i);
            delay(stepDelay);
        }
    } else {
        for (int i = fromPos; i >= toPos; i--) {
            servo.write(i);
            delay(stepDelay);
        }
    }
    
    servo.write(toPos);
    delay(30);
}

void moveServoFast(Servo &servo, int fromPos, int toPos) {
    int stepDelay = 8;
    int stepSize = 2;
    
    if (fromPos < toPos) {
        for (int i = fromPos; i <= toPos; i += stepSize) {
            servo.write(i);
            delay(stepDelay);
        }
    } else {
        for (int i = fromPos; i >= toPos; i -= stepSize) {
            servo.write(i);
            delay(stepDelay);
        }
    }
    servo.write(toPos);
    delay(50);
}

//==================================================
// FUNGSI KLASIFIKASI (Menggunakan metode dari program kalibrasi)
//==================================================

int klasifikasiBiji(int r, int g, int b) {
    // Cek KOSONG
    if (r <= KOSONG_R &&
        g <= KOSONG_G &&
        b <= KOSONG_B)
    {
        return 0; // KOSONG
    }
    
    // Cek ORANYE (Green - Red >= 2)
    else if ((g - r) >= SELISIH_MIN)
    {
        return 1; // ORANYE
    }
    
    // Cek HIJAU (Red - Green >= 2)
    else if ((r - g) >= SELISIH_MIN)
    {
        return 2; // HIJAU
    }
    
    // Jika tidak terdeteksi
    return -1; // TIDAK DIKETAHUI
}

bool adaBiji() {
    readAllColors();
    // Cek apakah nilai melebihi nilai KOSONG
    return (redValue > KOSONG_R + 5 || 
            greenValue > KOSONG_G + 5 || 
            blueValue > KOSONG_B + 5);
}

//==================================================
// FUNGSI PROSES SORTIR
//==================================================

void prosesSortir() {
    // ============================================
    // BACA NILAI AWAL
    // ============================================
    readAllColors();
    
    int rAwal = redValue;
    int gAwal = greenValue;
    int bAwal = blueValue;
    
    Serial.println("=========================================");
    Serial.println("📖 NILAI AWAL:");
    Serial.print("  🔴 R="); Serial.print(rAwal);
    Serial.print(" 🟢 G="); Serial.print(gAwal);
    Serial.print(" 🔵 B="); Serial.print(bAwal);
    Serial.print(" | R-G="); Serial.print(rAwal - gAwal);
    Serial.print(" | G-R="); Serial.println(gAwal - rAwal);
    
    // CEK KOSONG
    bool isKosong = (rAwal <= KOSONG_R &&
                     gAwal <= KOSONG_G &&
                     bAwal <= KOSONG_B);
    
    if (isKosong) {
        Serial.println(" | ⏳ KOSONG - Tidak ada biji!");
        return;
    }
    
    Serial.println(" | ✅ BIJI TERDETEKSI!");
    
    // ============================================
    // KLASIFIKASI
    // ============================================
    int kategori = klasifikasiBiji(rAwal, gAwal, bAwal);
    
    String namaWarna;
    int posisiServo2;
    
    if (kategori == 1) {
        namaWarna = "ORANYE (Grade A)";
        posisiServo2 = S2_MERAH;
        total_merah++;
        Serial.println("  🟠 ORANYE (Grade A) 🟠");
        Serial.print("  📊 Selisih G-R = ");
        Serial.println(gAwal - rAwal);
    } else if (kategori == 2) {
        namaWarna = "HIJAU (Reject)";
        posisiServo2 = S2_HIJAU;
        total_hijau++;
        Serial.println("  🟢 HIJAU (Reject) 🟢");
        Serial.print("  📊 Selisih R-G = ");
        Serial.println(rAwal - gAwal);
    } else {
        namaWarna = "TIDAK DIKETAHUI";
        posisiServo2 = S2_STANDBY;
        Serial.println("  ⚠️ TIDAK DIKETAHUI - Servo standby");
    }
    
    // Hanya proses jika biji terdeteksi (bukan unknown)
    if (kategori != -1 && kategori != 0) {
        total_sortir++;
        total_berat += BERAT_PER_BIJI;
        
        Serial.print("  📊 Total Sortir: ");
        Serial.print(total_sortir);
        Serial.print(" | ORANYE: ");
        Serial.print(total_merah);
        Serial.print(" | HIJAU: ");
        Serial.println(total_hijau);
        Serial.println("-----------------------------------------");
        
        // ============================================
        // STEP 1: SERVO 2 BERGERAK DULU
        // ============================================
        Serial.print("▶ [1] Servo 2 ke ");
        Serial.println(namaWarna);
        moveServoFast(servo2, S2_STANDBY, posisiServo2);
        delay(500);

        // ============================================
        // STEP 2: SERVO 1 KE POSISI BACA
        // ============================================
        Serial.println("▶ [2] Servo 1 ke posisi BACA (45°)");
        moveServoWithDebug(servo1, S1_STANDBY, S1_BACA, "Servo 1");
        delay(500);

        // ============================================
        // BACA LAGI UNTUK VERIFIKASI
        // ============================================
        readAllColors();

        // ============================================
        // STEP 3: SERVO 1 KEMBALI
        // ============================================
        Serial.println("▶ [3] Servo 1 kembali ke STANDBY (90°)");
        moveServoWithDebug(servo1, S1_BACA, S1_STANDBY, "Servo 1");
        delay(DELAY_RESET);
        
        // ============================================
        // STEP 4: SERVO 2 KEMBALI KE STANDBY
        // ============================================
        Serial.println("▶ [4] Servo 2 kembali ke STANDBY");
        moveServoFast(servo2, posisiServo2, S2_STANDBY);
        delay(300);
        
        // ============================================
        // KIRIM DATA KE SERVER
        // ============================================
        kirimDataKeServer(kategori, rAwal, gAwal, bAwal);
        
        // ============================================
        // TUNGGU BIJI HILANG
        // ============================================
        int timeout = 0;
        while (adaBiji() && timeout < 50) {
            delay(100);
            timeout++;
        }
        
        Serial.println("✅ Selesai");
    } else if (kategori == 0) {
        Serial.println("⚠️ Kondisi KOSONG, lewati proses sortir");
    } else {
        Serial.println("⚠️ Biji tidak teridentifikasi, lewati proses sortir");
    }
    
    Serial.println("=========================================");
}

//==================================================
// FUNGSI KONEKSI WiFi
//==================================================

void connectToWiFi() {
    Serial.print("📶 Menghubungkan ke WiFi ");
    WiFi.begin(ssid, password);
    
    int attempts = 0;
    while (WiFi.status() != WL_CONNECTED && attempts < 30) {
        delay(500);
        Serial.print(".");
        attempts++;
    }
    
    if (WiFi.status() == WL_CONNECTED) {
        Serial.println();
        Serial.println("✅ WiFi Connected!");
        Serial.print("📡 IP Address: ");
        Serial.println(WiFi.localIP());
    } else {
        Serial.println();
        Serial.println("❌ WiFi Gagal! Cek SSID dan Password.");
        Serial.println("⚠️ Data akan tetap disimpan, tapi tidak dikirim ke server.");
    }
}

//==================================================
// FUNGSI KIRIM DATA KE SERVER
//==================================================

void kirimDataKeServer(int kategori, int r, int g, int b) {
    // Cek koneksi WiFi, jika putus coba reconnect
    if(WiFi.status() != WL_CONNECTED){
        Serial.println("📶 WiFi putus, mencoba reconnect...");
        connectToWiFi();
    }
    
    if(WiFi.status() == WL_CONNECTED){
        HTTPClient http;
        http.begin(serverName);
        http.addHeader("Content-Type", "application/x-www-form-urlencoded");
        
        String warna;
        if (kategori == 1) {
            warna = "oranye";
        } else if (kategori == 2) {
            warna = "hijau";
        } else {
            warna = "unknown";
        }
        
        // Data yang dikirim
        String postData = "warna=" + warna;
        postData += "&r=" + String(r);
        postData += "&g=" + String(g);
        postData += "&b=" + String(b);
        postData += "&total_merah=" + String(total_merah);
        postData += "&total_hijau=" + String(total_hijau);
        postData += "&total_sortir=" + String(total_sortir);
        postData += "&berat=" + String(total_berat, 2);
        
        Serial.println("📤 Mengirim data ke server...");
        Serial.println(postData);
        
        int httpResponseCode = http.POST(postData);
        
        if (httpResponseCode > 0) {
            String response = http.getString();
            Serial.print("✅ Response: ");
            Serial.println(response);
        } else {
            Serial.print("❌ Error HTTP: ");
            Serial.println(httpResponseCode);
            Serial.println("⚠️ Data tidak terkirim, tapi tetap disimpan di ESP32.");
        }
        
        http.end();
    } else {
        Serial.println("❌ WiFi tidak terhubung! Data tidak dikirim.");
        Serial.println("💾 Data tetap tersimpan di ESP32 (total_merah, total_hijau, dll)");
    }
}

