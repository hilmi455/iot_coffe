void testSensor() {
    Serial.println();
    Serial.println("🔬 TEST SENSOR - Baca 5x pembacaan");
    Serial.println("-----------------------------------------");
    
    for (int i = 0; i < 5; i++) {
        readAllColors();
        int kategori = klasifikasiBiji(redValue, greenValue, blueValue);
        int selisihRG = redValue - greenValue;
        int selisihGR = greenValue - redValue;
        
        String status;
        if (kategori == 0) status = "KOSONG";
        else if (kategori == 1) status = "ORANYE";
        else if (kategori == 2) status = "HIJAU";
        else status = "UNKNOWN";
        
        Serial.print("Pembacaan ");
        Serial.print(i+1);
        Serial.print(": R=");
        Serial.print(redValue);
        Serial.print(" G=");
        Serial.print(greenValue);
        Serial.print(" B=");
        Serial.print(blueValue);
        Serial.print(" | R-G=");
        Serial.print(selisihRG);
        Serial.print(" | G-R=");
        Serial.print(selisihGR);
        Serial.print(" → ");
        Serial.println(status);
        
        delay(500);
    }
    Serial.println("-----------------------------------------");
    Serial.println("✅ Test selesai");
    Serial.println();
}

