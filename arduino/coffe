//==================================================
// FUNGSI KALIBRASI ULANG
//==================================================

void kalibrasiUlang() {
    Serial.println();
    Serial.println("╔═══════════════════════════════════════════╗");
    Serial.println("║         KALIBRASI ULANG                 ║");
    Serial.println("╠═══════════════════════════════════════════╣");
    Serial.println("║  Pastikan sensor dalam kondisi KOSONG!  ║");
    Serial.println("╚═══════════════════════════════════════════╝");
    Serial.println();
    Serial.print("Tekan 'y' untuk mulai kalibrasi: ");
    
    // Tunggu input dari Serial
    while (!Serial.available()) {
        delay(100);
    }
    
    char input = Serial.read();
    if (input == 'y' || input == 'Y') {
        Serial.println();
        Serial.println("📊 Membaca nilai KOSONG (rata-rata 10x)...");
        
        // Baca nilai kosong 10x
        long totalR = 0, totalG = 0, totalB = 0;
        for (int i = 0; i < 10; i++) {
            readAllColors();
            totalR += redValue;
            totalG += greenValue;
            totalB += blueValue;
            delay(100);
            Serial.print(".");
        }
        
        Serial.println();
        Serial.println("✅ Kalibrasi selesai!");
        Serial.print("Nilai KOSONG: R=");
        Serial.print(totalR/10);
        Serial.print(" G=");
        Serial.print(totalG/10);
        Serial.print(" B=");
        Serial.println(totalB/10);
        Serial.println("⚠️ Silahkan update konstanta KOSONG_R, KOSONG_G, KOSONG_B dengan nilai di atas!");
        Serial.println();
    } else {
        Serial.println();
        Serial.println("❌ Kalibrasi dibatalkan");
        Serial.println();
    }
}

//==================================================
// SETUP
//==================================================

void setup() {
    delay(1000);
    
    ESP32PWM::allocateTimer(0);
    ESP32PWM::allocateTimer(1);
    ESP32PWM::allocateTimer(2);
    ESP32PWM::allocateTimer(3);
    
    Serial.begin(115200);
    
    while (!Serial) {
        delay(10);
    }
    
    //===========================================
    // KONEKSI WiFi
    //===========================================
    Serial.println();
    Serial.println("=========================================");
    Serial.println("     COFFEE SORTING - ORANYE vs HIJAU");
    Serial.println("=========================================");
    
    connectToWiFi();
    
    Serial.println("=========================================");
    Serial.println("Kalibrasi (dari hasil kalibrasi):");
    Serial.println("  KOSONG : R<=56 G<=53 B<=43");
    Serial.println("  ORANYE : (G - R) >= 2");
    Serial.println("  HIJAU  : (R - G) >= 2");
    Serial.println("=========================================");
    Serial.println("LOGIKA:");
    Serial.println("  🟠 ORANYE (G-R >= 2) → 30°  (KIRI)");
    Serial.println("  🟢 HIJAU  (R-G >= 2) → 150° (KANAN)");
    Serial.println("=========================================");
    Serial.println();

    // Setup pin TCS3200
    pinMode(S0, OUTPUT);
    pinMode(S1, OUTPUT);
    pinMode(S2, OUTPUT);
    pinMode(S3, OUTPUT);
    pinMode(SENSOR_OUT, INPUT);

    // Set frekuensi awal (sesuai program kalibrasi)
    digitalWrite(S0, HIGH);
    digitalWrite(S1, LOW);

    servo1.attach(SERVO1_PIN, 500, 2500);
    servo2.attach(SERVO2_PIN, 500, 2500);

    servo1.write(S1_STANDBY);
    servo2.write(S2_STANDBY);
    
    Serial.println("✅ System Ready!");
    
    // Tampilkan menu utama
    tampilkanMenu();
}

//==================================================
// LOOP
//==================================================

void loop() {
    //===========================================
    // CEK INPUT DARI SERIAL MONITOR
    //===========================================
    if (Serial.available() > 0) {
        char command = Serial.read();
        
        // Hapus newline/karakter tambahan
        while (Serial.available() > 0) {
            Serial.read();
        }
        
        switch (command) {
            case '1': // Start Sortir 1x
                Serial.println();
                Serial.println("▶ START SORTIR (1x)");
                programRunning = true;
                autoMode = false;
                prosesSortir();
                programRunning = false;
                tampilkanMenu();
                break;
                
            case '2': // Start Auto Mode
                Serial.println();
                Serial.println("▶ START AUTO MODE");
                Serial.println("⚠️ Program akan terus berjalan dan mendeteksi biji secara otomatis");
                Serial.println("⚠️ Tekan '3' untuk STOP");
                autoMode = true;
                programRunning = true;
                Serial.println();
                break;
                
            case '3': // Stop
                Serial.println();
                Serial.println("⏹ STOP SORTIR");
                programRunning = false;
                autoMode = false;
                tampilkanMenu();
                break;
                
            case '4': // Tampilkan Statistik
                tampilkanStatistik();
                tampilkanMenu();
                break;
                
            case '5': // Reset Statistik
                Serial.println();
                Serial.println("🔄 RESET STATISTIK");
                total_merah = 0;
                total_hijau = 0;
                total_sortir = 0;
                total_berat = 0.0;
                Serial.println("✅ Statistik berhasil di-reset!");
                tampilkanStatistik();
                tampilkanMenu();
                break;
                
            case '6': // Test Sensor
                testSensor();
                tampilkanMenu();
                break;
                
            case '7': // Test Servo
                testServo();
                tampilkanMenu();
                break;
                
            case '8': // Kalibrasi Ulang
                kalibrasiUlang();
                tampilkanMenu();
                break;
                
            default:
                Serial.println();
                Serial.println("❌ Perintah tidak dikenal! Gunakan menu 1-8");
                tampilkanMenu();
                break;
        }
    }
    
    //===========================================
    // AUTO MODE - Jalan terus
    //===========================================
    if (autoMode && programRunning) {
        // Cek apakah ada biji
        readAllColors();
        bool isKosong = (redValue <= KOSONG_R &&
                         greenValue <= KOSONG_G &&
                         blueValue <= KOSONG_B);
        
        if (!isKosong) {
            // Ada biji, proses sortir
            prosesSortir();
        } else {
            // Tidak ada biji, tampilkan dot sebagai indikator
            static unsigned long lastPrint = 0;
            if (millis() - lastPrint > 1000) {
                Serial.print(".");
                lastPrint = millis();
            }
        }
        
        // Delay kecil agar tidak terlalu cepat looping
        delay(100);
    }
    
    //===========================================
    // JIKA TIDAK AUTO MODE, TUNGGU PERINTAH
    //===========================================
    if (!autoMode && !programRunning) {
        // Tidak melakukan apa-apa, menunggu perintah dari Serial
        delay(100);
    }
}